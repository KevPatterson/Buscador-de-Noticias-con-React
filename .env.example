# API Keys del servidor (configurarlas en Vercel. NUNCA prefijarlas con VITE_
# para que no queden expuestas en el bundle del navegador).
# Opcionales: la app funciona solo con fuentes RSS si no se configuran.
NEWSDATA_API_KEY=tu_key_de_newsdata
THENEWSAPI_KEY=tu_key_de_thenewsapi
NEWSAPI_KEY=tu_key_de_newsapi_org

# Dominio de despliegue en Vercel (se usa para CORS restringido).
# Ejemplo: VERCEL_URL=cubapress.vercel.app
VERCEL_URL=

# Configuracion de scraping (opcional)
SCRAPE_API_BASE_URL=

# Dominios bloqueados para reportes (separados por coma)
REPORT_BLOCKED_DOMAINS=news.google.com
