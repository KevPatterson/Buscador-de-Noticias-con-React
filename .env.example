# ============================================================================
# CLAVES DE APIS DE NOTICIAS (SERVIDOR SOLAMENTE)
# ============================================================================
# IMPORTANTE: Estas claves NUNCA deben prefijarse con VITE_ para evitar
# exponerlas en el bundle del navegador. Se usan solo en el servidor (api/news.js).
# Opcionales: la app funciona solo con fuentes RSS si no se configuran.
# Las APIs se intentan en cascada: NewsData -> TheNewsAPI -> NewsAPI -> RSS.

# Clave de API para NewsData.io (https://newsdata.io)
# Solicitar en: https://newsdata.io
# Nota: Usar domainurl es más eficiente para fuentes específicas
NEWSDATA_API_KEY=

# Clave de API para TheNewsAPI (https://thenewsapi.com)
# Solicitar en: https://thenewsapi.com
THENEWSAPI_KEY=

# Clave de API para NewsAPI.org (https://newsapi.org)
# Solicitar en: https://newsapi.org
NEWSAPI_KEY=

# ============================================================================
# CONFIGURACION DE VERCEL
# ============================================================================
# URL de despliegue en Vercel (se usa para CORS restringido y validación SSRF).
# Ejemplo: VERCEL_URL=cubapress.vercel.app
# Se rellena automáticamente en Vercel. En desarrollo, dejar vacío.
VERCEL_URL=

# ============================================================================
# CONFIGURACION AVANZADA (OPCIONAL)
# ============================================================================
# URL base para llamadas internas de scraping (si se expone api/scrape como endpoint público)
# En desarrollo: http://localhost:5173
# En producción: dejar vacío (usa la URL actual)
SCRAPE_API_BASE_URL=

# Dominios bloqueados para reportes de artículos (separados por coma, sin espacios)
# Ejemplo: REPORT_BLOCKED_DOMAINS=news.google.com,facebook.com
REPORT_BLOCKED_DOMAINS=news.google.com

# ============================================================================
# RESUMEN CON IA (OPCIONAL)
# ============================================================================
# Proveedor compatible con la API de OpenAI (OpenAI, Groq, Together, etc.).
# Sin RESUMEN_API_KEY, /api/resumen responde disponible:false y la interfaz
# oculta la opcion de resumen con IA del carrito.
RESUMEN_API_KEY=
# Endpoint de chat completions. Ejemplo: https://api.openai.com/v1/chat/completions
RESUMEN_API_URL=
# Modelo a usar. Ejemplo: gpt-4o-mini
RESUMEN_MODELO=
